# Copiar a .env (NUNCA commitear .env). Solo valores de desarrollo local.

# Cualquier Postgres con PostGIS. Este es el del Supabase CLI local de guazu (puertos propios,
# para convivir con almacenero: 55321+, no 54321+).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55322/postgres

# JWKS del proveedor de auth (tokens ES256: default del Supabase CLI).
JWKS_URL=http://127.0.0.1:55321/auth/v1/.well-known/jwks.json

# API de auth que usará /v1/auth/* (el cliente no habla con el proveedor). La api key es
# la ANON_KEY de `supabase status`; `make up` la completa en .env.
AUTH_URL=http://127.0.0.1:55321/auth/v1
AUTH_API_KEY=

# Alternativa para tokens HS256.
JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long
JWT_AUDIENCE=authenticated

# Orígenes web que pueden llamar a la API (CORS): el panel de plataforma.
# CORS_ORIGINS=http://localhost:8180,http://127.0.0.1:8180

LOG_LEVEL=INFO

# Proxies confiables delante del backend (0 = ninguno).
PROXY_HOPS=0

# Versión que informa /v1/salud (en la imagen de producción la fija el build).
# APP_VERSION=0.0.0-dev
